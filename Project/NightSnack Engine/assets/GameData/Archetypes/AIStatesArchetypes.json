{

    "StatesEntityTest1": {
      "States": {
        "DecisionState": {
          "transitions": [
            { "target": "MoveLeftState", "condition": "IsPlayerLeftSide" },
            { "target": "MoveRightState", "condition": "IsPlayerRightSide" }
          ]
        },
        "MoveLeftState": {
          "behaviourTypes": { 
            "movement" : {"fx": -350.0, "fy": 0.0 }
          },
          "transitions": [
            { "target": "CountdownState", "condition": "IsCollided" }
          ]
        },
        "MoveRightState": {
          "behaviourTypes": { 
            "movement" : {"fx": 350.0, "fy": 0.0 }
          },
          "transitions": [
            { "target": "CountdownState", "condition": "IsCollided" }
          ]
        },
        "CountdownState": {
          "behaviourTypes": { "countdown": 3.0 },
          "transitions": [
            { "target": "DecisionState", "condition": "CountdownCompleted" }
          ]
        }
      },
      "InitialState": "DecisionState"
    },

    "StatesEntityTest2": {
      "States": {
          "CooldownState": {
            "behaviourTypes": { "countdown": 1.5 },
            "transitions": [
              { "target": "JumpState", "condition": "CountdownCompleted" }
            ]
        },
          "JumpState": {
            "behaviourTypes": { "impulse" : {"fx": 0.0, "fy": 500.0 } },
            "transitions": [
              { "target": "CooldownState", "condition": "IsGrounded" }
            ]
        },
          "StartingState": {
            "transitions": [
              { "target": "JumpState", "condition": "IsGrounded" }
            ]
        }       
      },
      "InitialState": "StartingState"
    }
}